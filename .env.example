# Copy to .env.local and fill in. Next.js reads .env.local, not this file.

# Resumes offered by the "Resume" menu (served through /api/resume?type=...).
# Accepts a direct PDF URL, a Google Drive/Docs share link, or a path in /public (e.g. /resume.pdf).
BLOCKCHAIN_DEVELOPER_RESUME_URL=
FULLSTACK_BLOCKCHAIN_DEVELOPER_RESUME_URL=

# Contact links — each one is hidden when empty.
CONTACT_EMAIL=
CONTACT_NUMBER=
GITHUB=
LINKEDIN_URL=
X_URL=
INSTAGRAM=
THREADS=
